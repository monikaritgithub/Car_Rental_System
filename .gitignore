# Virtual environment — never commit this
.venv/
venv/
env/

# Python compiled files
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python egg / distribution
*.egg
*.egg-info/
dist/
build/
.eggs/

# Environment variables — keep secrets out of git
.env
.env.local
.env.*.local

# SQLite database files
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db-journal
*.db-shm
*.db-wal

# Pytest cache
.pytest_cache/
.cache/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml

# IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
ehthumbs.db

# draw.io backup files (auto-generated, not useful in git)
*.bkp

# Temporary and log files
*.log
*.tmp
*.temp
tmp/
temp/

# Flask session files
flask_session/

# AI Agent tracking files
state.json
task.md
