        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Customer\n    participant UI as UI Controller\n    participant Engine as Booking Engine\n    participant DB as Car Database\n    participant Payment as Payment Gateway\n    actor Employee\n\n    Customer-&gt;&gt;UI: Search available cars\n    UI-&gt;&gt;DB: Query cars where availableNow = true\n    DB--&gt;&gt;UI: Return car list\n    UI--&gt;&gt;Customer: Display cars and details\n    \n    Customer-&gt;&gt;UI: Select dates and book car\n    UI-&gt;&gt;Engine: Validate availability and rent period\n    Engine--&gt;&gt;UI: Return validation result\n    UI-&gt;&gt;Engine: Request fee calculation (Days × Rate)\n    Engine--&gt;&gt;UI: Return total fee\n    UI--&gt;&gt;Customer: Display fee summary\n    \n    Customer-&gt;&gt;UI: Enter card details and pay\n    UI-&gt;&gt;Payment: Send transaction\n    Payment--&gt;&gt;UI: Return payment approval\n    \n    UI-&gt;&gt;Engine: Create booking with Status: PENDING\n    Engine-&gt;&gt;DB: Save booking record\n    DB--&gt;&gt;Engine: Confirm save\n    Engine--&gt;&gt;Customer: Show booking pending notice\n    \n    Engine-&gt;&gt;Employee: Notify employee of new pending booking\n    Employee-&gt;&gt;Engine: Approve or reject booking\n    Engine-&gt;&gt;DB: Update status (APPROVED/REJECTED)\n    Engine-&gt;&gt;DB: Update car availableNow = false\n    Engine--&gt;&gt;Customer: Send final confirmation notification&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="a3GvzGbV9oUs8jcYiUUA-12">
